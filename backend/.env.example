APP_ENV=local
DUCKDB_PATH=data/ecommerce.duckdb
SQLITE_PATH=data/metadata.sqlite
# WSL faster local storage:
# DUCKDB_PATH=/home/hao/.local/share/nl2sql_pro/ecommerce.duckdb
# SQLITE_PATH=/home/hao/.local/share/nl2sql_pro/metadata.sqlite
DATASET_CURRENT_DATE=2025-12-31
# Optional YAML manifest for demo seed semantics. Defaults to the bundled e-commerce overlay.
# SEMANTIC_OVERLAY_PATH=/path/to/semantic_overlay.yml

# LLM and SQL generation
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=30
# Semantic grounding guard is on by default. Use off only as an emergency/test override.
SEMANTIC_GUARD_MODE=warn
SEMANTIC_GUARD_TIMEOUT=30
SQL_DEFAULT_RANKING_LIMIT=10
SQL_DEFAULT_BROWSE_LIMIT=20

# Vector retrieval
# Auto uses vector retrieval when Qdrant, embeddings, and the vector index are available.
# Set VECTOR_ENABLED=disabled only when you need to force vector retrieval off.
VECTOR_ENABLED=auto
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=nl2sql
QDRANT_TIMEOUT_SECONDS=60
# Leave blank to use the built-in default model:
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# First use may download it into the model cache. Set a local path to avoid
# downloads only when deliberately testing another SentenceTransformer model.
EMBEDDING_MODEL=
VECTOR_SIMILARITY_THRESHOLD=0.7
VALUE_VECTOR_SIMILARITY_THRESHOLD=0.75

# Retrieval recall expansion. Defaults are conservative/off until eval-calibrated.
RETRIEVAL_EXPANSION_ENABLED=false
RETRIEVAL_FALLBACK_MODE=off
RETRIEVAL_COVERAGE_THRESHOLD=0.7
RETRIEVAL_COVERAGE_STRENGTH_WEIGHT=0.5
RETRIEVAL_COVERAGE_STRUCTURAL_WEIGHT=0.5
RETRIEVAL_EXPANSION_MAX_TABLES=3
RETRIEVAL_FACT_MIN_DIM_EDGES=2
RETRIEVAL_FULL_SCHEMA_CHAR_BUDGET=120000

DEFAULT_DATASOURCE=duckdb_ecommerce
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DATABASE=ecommerce
CLICKHOUSE_READONLY=true
CLICKHOUSE_MAX_EXECUTION_TIME=30
CLICKHOUSE_MAX_RESULT_ROWS=10000

# Optional streamable HTTP MCP token. When set, /mcp/ requires this value in
# X-Service-Token.
NL2SQL_MCP_SERVICE_TOKEN=
# Comma-separated Host header allowlist for MCP DNS-rebinding protection.
# Include Docker service names used by MCP clients in deployed compose networks.
NL2SQL_MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000,backend:8000,nl2sql_pro-backend-1:8000,host.docker.internal:8000,172.17.0.1:8000,172.18.0.1:8000,172.22.0.1:8000
NL2SQL_MCP_ALLOWED_ORIGINS=

# Login system. See docs/DEVELOPMENT.md#auth-deployment before deploying.
# Set AUTH_ENABLED=true and provide a bootstrap password to create
# the first admin user in AUTH_SQLITE_PATH when the auth DB is empty. The SQLite
# auth store is intended for one backend process per DB file; do not run
# `uvicorn --workers N` against the same AUTH_SQLITE_PATH. Use separate DB paths
# per project, or move auth sessions/users to Postgres/Redis before scaling out.
AUTH_ENABLED=false
AUTH_COOKIE_NAME=nl2sql_session
# Keep true for HTTPS deployments. Set false only for local HTTP development.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=28800
AUTH_SQLITE_PATH=data/auth.sqlite
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_LOGIN_LOCKOUT_SECONDS=300

# Comma-separated frontend origins allowed to call the API with cookies.
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:5173,http://localhost:5174,http://localhost:5175
